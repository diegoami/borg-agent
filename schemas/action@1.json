{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/diegoami/borg-agent/schemas/action@1.json",
  "title": "Action (borg-agent/action@1)",
  "description": "One answer from the mind (R1.2, R2). It is a primitive the executor runs, a single game command with its arguments, or raw keys as an escape hatch. The connector translates it to keypresses; raw keys are logged as raw. Every action carries a one-line reason.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": ["schema", "kind", "reason"],
  "properties": {
    "schema": {"const": "borg-agent/action@1"},
    "kind": {"type": "string", "enum": ["primitive", "command", "keys"]},
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\n\\r]+$",
      "description": "One line, in the mind's own words, recorded with the call (R2.1)."
    },
    "note": {
      "type": ["string", "null"],
      "description": "An observation note for the notebook (R2.3), if this decision taught something."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "primitive"}}},
      "then": {
        "required": ["primitive"],
        "properties": {
          "primitive": {
            "type": "object",
            "unevaluatedProperties": false,
            "required": ["name"],
            "description": "The executor primitives of R2. They are mechanical and carry no tactics; choosing between them is the mind's job.",
            "properties": {
              "name": {
                "type": "string",
                "enum": ["walk_to", "explore_floor", "fight_nearest", "rest_until_healed",
                          "take_stairs", "flee", "read_unknown_scroll", "shop_list"]
              }
            },
            "allOf": [
              {
                "if": {"properties": {"name": {"const": "walk_to"}}},
                "then": {
                  "required": ["target"],
                  "properties": {"target": {"$ref": "#/$defs/point"}}
                }
              },
              {
                "if": {"properties": {"name": {"const": "take_stairs"}}},
                "then": {
                  "required": ["direction"],
                  "properties": {"direction": {"type": "string", "enum": ["down", "up"]}}
                }
              },
              {
                "if": {"properties": {"name": {"const": "flee"}}},
                "then": {
                  "required": ["by"],
                  "properties": {"by": {"type": "string", "enum": ["stairs", "phase_door"]}}
                }
              },
              {
                "if": {"properties": {"name": {"const": "shop_list"}}},
                "then": {
                  "required": ["list"],
                  "properties": {
                    "list": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["label", "count"],
                        "properties": {
                          "label": {"type": "string", "minLength": 1},
                          "count": {"type": "integer", "minimum": 1},
                          "side": {"type": "string", "enum": ["buy", "sell"], "default": "buy"}
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "command"}}},
      "then": {
        "required": ["command"],
        "properties": {
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "description": "One game command with its arguments, named as the game's command list names it.",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "direction": {"type": "integer", "enum": [1, 2, 3, 4, 6, 7, 8, 9],
                            "description": "The number-pad direction, as in 'walk 6'. 5 is not a direction, so it is not accepted."},
              "item": {"type": "string", "minLength": 1, "maxLength": 1,
                       "description": "The inventory, equipment or spell letter the command asks for."},
              "target": {"$ref": "#/$defs/point"},
              "target_nearest": {"type": "boolean"},
              "count": {"type": "integer", "minimum": 1},
              "answer": {"type": "string", "description": "The answer to a prompt the command raises, for example 'y'."}
            },
            "not": {"required": ["target", "target_nearest"]}
          }
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "keys"}}},
      "then": {
        "required": ["keys"],
        "properties": {
          "keys": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keys", "why"],
            "description": "The escape hatch (R1.2). Logged as raw keys, so a reader can tell these apart from commands the connector built.",
            "properties": {
              "keys": {"type": "string", "minLength": 1},
              "why": {"type": "string", "minLength": 1, "description": "Why no command covers this."}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}
    }
  }
}
